<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">
  <Id>aeaf27de-4d1e-40ad-af3a-f4a75ef57ef8</Id>
  <Version>1.0.2.0</Version>
  <ProviderName>DHRlabs</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Time Zones"/>
  <Description DefaultValue="Shows a message's times in your time zone and adds time zones to times you write."/>
  <IconUrl DefaultValue="https://dhrlabs.github.io/outlook-timezones/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://dhrlabs.github.io/outlook-timezones/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://github.com/DHRlabs/outlook-timezones"/>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://dhrlabs.github.io/outlook-timezones/src/read.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>true</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <!-- OnMessageSend arrived in mailbox requirement set 1.12, so the ribbon and the launch
           event need 1.12. The base Requirements above stay at 1.5, so the add-in still installs
           on a 1.5 client and the read pane still opens there through FormSettings; only the
           ribbon buttons and the send event need the newer client. -->
      <Requirements>
        <bt:Sets DefaultMinVersion="1.12">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <!-- Event-based activation runs in a lightweight runtime (Smart Alerts walkthrough,
               add-in only manifest: "Event-based activation happens in a lightweight runtime").
               The Runtime resid is the HTML page Outlook on the web, on Mac, and new Outlook on
               Windows load; the javascript Override is the file classic Outlook on Windows loads. -->
          <Runtimes>
            <Runtime resid="commandsUrl">
              <Override type="javascript" resid="jsRuntimeUrl"/>
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="commandsUrl"/>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="readGroup">
                  <Label resid="groupLabel"/>
                  <Control xsi:type="Button" id="readPaneButton">
                    <Label resid="paneLabel"/>
                    <Supertip>
                      <Title resid="paneLabel"/>
                      <Description resid="paneTip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16"/>
                      <bt:Image size="32" resid="icon32"/>
                      <bt:Image size="80" resid="icon80"/>
                    </Icon>
                    <Action xsi:type="ShowTaskpane">
                      <SourceLocation resid="readUrl"/>
                      <SupportsPinning>true</SupportsPinning>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="MessageComposeCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="composeGroup">
                  <Label resid="addLabel"/>
                  <Control xsi:type="Button" id="addZonesButton">
                    <Label resid="addLabel"/>
                    <Supertip>
                      <Title resid="addLabel"/>
                      <Description resid="addTip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="icon16"/>
                      <bt:Image size="32" resid="icon32"/>
                      <bt:Image size="80" resid="icon80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>addTimeZones</FunctionName>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <!-- Add time zones automatically when the message is sent. SendMode "PromptUser" means
                 that if the add-in is unavailable or errors, "the item will be sent": a failure here
                 never blocks a send. SourceLocation names the browser runtime above. -->
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnMessageSend" FunctionName="onMessageSendHandler" SendMode="PromptUser"/>
              </LaunchEvents>
              <SourceLocation resid="commandsUrl"/>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="icon16" DefaultValue="https://dhrlabs.github.io/outlook-timezones/assets/icon-16.png"/>
          <bt:Image id="icon32" DefaultValue="https://dhrlabs.github.io/outlook-timezones/assets/icon-32.png"/>
          <bt:Image id="icon80" DefaultValue="https://dhrlabs.github.io/outlook-timezones/assets/icon-80.png"/>
          <bt:Image id="icon-16" DefaultValue="https://dhrlabs.github.io/outlook-timezones/assets/icon-16.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="readUrl" DefaultValue="https://dhrlabs.github.io/outlook-timezones/src/read.html"/>
          <bt:Url id="commandsUrl" DefaultValue="https://dhrlabs.github.io/outlook-timezones/src/commands.html"/>
          <!-- Entry needed for classic Outlook on Windows. -->
          <bt:Url id="jsRuntimeUrl" DefaultValue="https://dhrlabs.github.io/outlook-timezones/src/commands.js"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="groupLabel" DefaultValue="Time Zones"/>
          <bt:String id="paneLabel" DefaultValue="Time Zones"/>
          <bt:String id="addLabel" DefaultValue="Add time zones"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="paneTip" DefaultValue="Open and pin to see times in your time zone on each message."/>
          <bt:String id="addTip" DefaultValue="Add time zones to each clock time in this draft."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
